# ==============================================================================
# LASAK AI / PORTFOLIO CHATBOT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your actual credentials.
# WARNING: Never commit '.env' containing real secrets to Git.
# ==============================================================================

# Server Listening Port (Local Development Only)
PORT=8080

# Environment Mode ('development' or 'production')
NODE_ENV=development

# Trust Reverse Proxies (Vercel/Cloudflare/Nginx)
# Options: 'true', 'false', or number of proxy hops (e.g. 1)
TRUST_PROXY=true

# ── API KEYS & PROVIDERS ──────────────────────────────────────────────────────
# Comma-separated list of Gemini API Keys for rotation / rate-limit failovers.
# The server will automatically rotate through these keys.
GEMINI_API_KEYS=gemini_key_1,gemini_key_2

# Optional fallback keys if all Gemini keys fail
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── SECURITY & ADMINISTRATION ─────────────────────────────────────────────────
# Secret token for admin routes like flushing caches or reading statistics.
# Must be passed in authorization header as 'Bearer <key>' or 'x-admin-key'.
ADMIN_SECRET_KEY=your_cache_management_secret_key_here

# Comma-separated list of trusted frontend origins allowed by CORS policies.
# Leave blank in development to auto-allow localhost.
ALLOWED_ORIGINS=https://your-custom-domain.com,https://your-portfolio.vercel.app

# ── REDIS CONNECTION (BullMQ & Cache Limiter) ─────────────────────────────────
# Setup a free Redis instance on Upstash (https://upstash.com) for Vercel Serverless.
REDIS_HOST=your-redis-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ── QDRANT VECTOR DATABASE (Semantic RAG) ─────────────────────────────────────
# Setup a free Qdrant cluster on Qdrant Cloud (https://qdrant.tech).
Qdrant_URL=https://your-qdrant-cluster-id.gcp.qdrant.tech:6333
QDRANT_API_KEY=your_qdrant_api_key_here
